#!/usr/bin/env node
'use strict';

const http = require('node:http');

const port = process.env.ZENOS_PORT || 4000;
const host = process.env.ZENOS_HOST || '127.0.0.1';

const args = process.argv.slice(2);
let testCommand = 'node --test';
let targetFiles = [];

for (let i = 0; i < args.length; i++) {
  if (args[i] === '--cmd' && i + 1 < args.length) {
    testCommand = args[++i];
  } else if (args[i] === '--files' && i + 1 < args.length) {
    targetFiles = args[++i].split(',').map((s) => s.trim());
  } else if (args[i] === '--help' || args[i] === '-h') {
    process.stdout.write('Usage: cook [--cmd "node --test"] [--files "file1.js,file2.js"]\n');
    process.exit(0);
  }
}

const payload = JSON.stringify({ testCommand, targetFiles });

const req = http.request(
  {
    hostname: host,
    port,
    path: '/v1/factory/cook',
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'Content-Length': Buffer.byteLength(payload)
    }
  },
  (res) => {
    let body = '';
    res.on('data', (chunk) => { body += chunk; });
    res.on('end', () => {
      try {
        const json = JSON.parse(body);
        process.stdout.write(JSON.stringify(json, null, 2) + '\n');
        process.exit(json.success ? 0 : 1);
      } catch {
        process.stdout.write(body + '\n');
        process.exit(res.statusCode >= 400 ? 1 : 0);
      }
    });
  }
);

req.on('error', (err) => {
  process.stderr.write(`Error connecting to ZenOS Proxy: ${err.message}\n`);
  process.exit(1);
});

req.write(payload);
req.end();
